# AlertPulse — example environment variables.
# Copy to .env and fill in real values. PLACEHOLDER VALUES ONLY — no real
# secrets are in this file. Never commit a real .env.
# DEMO ONLY — not for clinical use; see README.md.

# Required: PostgreSQL connection string (Neon, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/alertpulse

# Server port (default 3000)
PORT=3000

# Admin secret for /api/admin, /api/cold-email, /api/patent (x-admin-secret header)
ADMIN_SECRET=change-me-to-a-long-random-secret

# Email address for patent-reminder alerts (jobs/patent-reminder.js)
ADMIN_EMAIL=admin@example.com

# Base URL of the deployed app (used for Stripe success_url in admin routes)
APP_URL=http://localhost:3000

# Polsia AI proxy (lib/polsia-ai.js)
POLSIA_API_KEY=
POLSIA_API_URL=https://polsia.com/api/proxy/ai
POLSIA_SUBSCRIPTION_ID=
POLSIA_ANALYTICS_SLUG=

# Hunter.io email verification (services/cold-email.js)
HUNTER_API_KEY=

# SMTP for cold email (services/cold-email.js). Leave unset to use the
# Polsia company_email fallback (queued only in this demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=AlertPulse <hello@alertpulse.ai>

# Cold-email batch size (services/cold-email.js, default 2)
EMAIL_BATCH_SIZE=2
