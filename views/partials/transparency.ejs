              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="#0ea5e9" stroke-width="1.5"/><path d="M7 4v3.5L9 9" stroke="#0ea5e9" stroke-width="1.2" stroke-linecap="round"/></svg>
